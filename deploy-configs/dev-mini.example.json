{
  "ensure": {
    "compose_file": "/path/to/infra/dev-mini/layer-20/compose.yml",
    "services": [
      "authservice",
      "swayrider-api-register",
      "mailservice"
    ]
  },
  "driver": "compose-single-machine",
  "host": null,
  "activation_order": [
    "geodata",
    "valhalla",
    "pelias",
    "tiles"
  ],
  "classes": {
    "geodata": {
      "root": "/path/to/geodata",
      "activate": {
        "type": "compose-restart",
        "compose_file": "/path/to/infra/dev-mini/layer-20/compose.yml",
        "services": {
          "all": "regionservice"
        }
      }
    },
    "valhalla": {
      "root": "/path/to/valhalla",
      "activate": {
        "type": "compose-restart",
        "compose_file": "/path/to/infra/dev-mini/layer-10/compose.yaml",
        "services": {
          "benelux": "valhalla-benelux",
          "france": "valhalla-france",
          "germany": "valhalla-germany"
        },
        "ensure_after": {
          "compose_file": "/path/to/infra/dev-mini/layer-20/compose.yml",
          "services": [
            "routerservice"
          ]
        }
      }
    },
    "pelias": {
      "root": "/path/to/pelias",
      "es_snapshots": "/path/to/elasticsearch/snapshots",
      "activate": {
        "type": "pelias-restore",
        "compose_file": "/path/to/infra/dev-mini/layer-10/compose.yaml",
        "es_url": "http://localhost:39200",
        "restart": {
          "region": [
            "pelias-{region}-pip",
            "pelias-{region}-interpolation",
            "pelias-{region}-api"
          ],
          "shared": [
            "pelias-placeholder"
          ]
        },
        "ensure": [
          "pelias-libpostal"
        ],
        "ensure_after": {
          "compose_file": "/path/to/infra/dev-mini/layer-20/compose.yml",
          "services": [
            "searchservice"
          ]
        }
      }
    },
    "tiles": {
      "transport": "s3",
      "endpoint": "http://127.0.0.1:39000",
      "region": "garage",
      "bucket": "swayrider-tiles",
      "credentials": {
        "access_key_env": "DM_S3_ACCESS_KEY",
        "secret_key_env": "DM_S3_SECRET_KEY"
      },
      "activate": {
        "type": "tilesservice-env",
        "env_file": "/path/to/infra/dev-mini/layer-20/tiles-release.env",
        "compose_file": "/path/to/infra/dev-mini/layer-20/compose.yml",
        "service": "tilesservice"
      }
    }
  }
}
