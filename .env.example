# Copy to .env for local overrides. Not committed (see .gitignore).
#
# Bootstrap ("where's my DB/broker") config only — domain configuration
# (regions, profiles, ...) lives in the database starting Phase 1, not here.

# Dedicated data-manager Redis from infra/data-manager/compose.yaml,
# reachable on the host at its mapped port (see infra/data-manager/README.md).
REDIS_URL=redis://localhost:36389/0

DATABASE_PATH=./data/state/db.sqlite3
DATA_ROOT=./data
# Package repository (own folder, ideally another filesystem); empty = $DATA_ROOT/releases
PACKAGE_ROOT=

# Deploy to the object store (Garage) that holds the tiles release. These are the READ/WRITE key of that store
# (infra/dev-mini/layer-00/.env: GARAGE_RW_ACCESS_KEY_ID and GARAGE_RW_SECRET_KEY), never the read-only one.
# A deploy configuration only stores these two variable NAMES (credentials.access_key_env / secret_key_env).
# The web app and the worker both read this file when they start: restart ./debug.sh after changing it.
#DM_S3_ACCESS_KEY=GKxxxxxxxxxxxxxxxxxxxxxxxx
#DM_S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Where the Natural Earth admin-0 countries archive is downloaded/cached.
NATURAL_EARTH_URL=https://naturalearth.s3.amazonaws.com/10m_cultural/ne_10m_admin_0_countries.zip
NATURAL_EARTH_DIR=./data/downloads/natural-earth

SECRET_KEY=change-me
LOG_LEVEL=INFO
LOG_JSON=true

# Needed by the `flask` CLI (flask run / flask seed-countries).
FLASK_APP=wsgi.py
